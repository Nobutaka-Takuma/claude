# Local Postgres connection used in place of a hosted Supabase project.
# For a live deployment this is the Supabase connection string — see
# docs/DEPLOY.md, which explains why the app uses the transaction pooler
# (6543) and migrations use 5432. The same migration list applies in both
# places: 0000 detects a Supabase project and skips itself.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/prediction_market

# Signs the session cookie issued by app/lib/auth.ts. Generate a real
# secret for anything beyond local dev: `openssl rand -hex 32`.
SESSION_SECRET=dev-only-secret-change-me

# Shared secret an ad network would sign its SSV (server-side verification)
# webhook callbacks with. See app/api/webhooks/ad-reward/route.ts.
AD_NETWORK_SSV_SECRET=dev-only-ssv-secret

# --- News ingestion (scripts/sync-news.mjs) ---

# Feeds to pull articles from. Leave unset to use the defaults in
# scripts/news-sources/feeds.mjs (Yahoo!ニュース + NHK). Publishers retire
# feed URLs without notice, so verify them — sync-news reports each feed
# separately so a dead one is visible rather than silent.
# NEWS_FEEDS=[{"url":"https://example.com/rss.xml","source":"Example","category":"economy"}]

# How many items to take per feed, and how old an article may be before
# it's ignored.
NEWS_SYNC_PER_FEED_LIMIT=10
NEWS_SYNC_MAX_AGE_DAYS=3

# Default interval for `npm run sync-news -- --watch` (minutes), used when
# no explicit interval is passed on the command line.
NEWS_SYNC_INTERVAL_MINUTES=30

# Optional shared secret for POST /api/news/sync. Set it to let an
# external scheduler (cron, GitHub Actions, Vercel Cron) trigger a refresh
# by sending it as the `x-news-sync-secret` header. Leave unset and only
# signed-in admins can refresh, via the 🔄 button on /news.
# NEWS_SYNC_SECRET=

# Shared secret Vercel Cron presents as `Authorization: Bearer <value>`
# when it calls /api/cron/tick and /api/news/sync. Generate one per
# deployment: `openssl rand -hex 32`. Without it those endpoints reject
# every scheduled call.
# CRON_SECRET=

# Maximum Postgres connections per serverless instance. Each instance gets
# its own pool and a Supabase project has a fixed budget shared across all
# of them, so lower this if you see connection errors under load.
# PGPOOL_MAX=5

# --- 運営者情報（法務ページ・広告審査で必須）---
#
# /terms /privacy /operator /contact の4ページはここを読んで表示します。
# ソースコードに直書きしていないのは、法務ページで一番まずいのが「体裁は
# 整っているが中身が嘘」の状態だからです。サンプルの会社名が入ったまま
# 公開されたプライバシーポリシーは、何も無いより悪い。
#
# 未設定の項目があるうちは、各ページの先頭に赤い警告が出ます。広告
# ネットワーク・ASPに申し込む前に必ず埋めてください（本番は Vercel の
# Environment Variables に設定します）。
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_CONTACT_EMAIL=
SITE_URL=

# 規約・ガイドラインへの導線を全ページのフッターに出すかどうか。
#
# β版で身内しか見ていない間は場所を取るだけなので、既定では出さず
# マイページの下部にだけ置いています（各ページはURLで常に開けます）。
#
# 一般公開するとき、および広告ネットワーク・ASPに申し込むときは true に
# してください。審査は「どのページからでもプライバシーポリシーに到達
# できるか」を見るので、false のままだとその一点で落ちます。
# SHOW_LEGAL_FOOTER=true

# 任意。空なら「—」と表示されます。
# OPERATOR_REPRESENTATIVE=
# OPERATOR_ESTABLISHED=2026年8月
# OPERATOR_BUSINESS=予測市場型コミュニティサービスの企画・運営、広告事業
# SERVICE_NAME=Prediction Market DAO

# 年齢の下限と、保護者の同意が必要になる年齢（利用規約 第2条に反映）。
# 予測市場に見た目が近いサービスなので、18歳未満を一律で不可にする判断も
# ありえます。その場合は MINIMUM_AGE=18 にしてください。
# MINIMUM_AGE=13
# PARENTAL_CONSENT_AGE=18

# --- Economy ---

# Points a new account is granted from the treasury on signup.
SIGNUP_BONUS_POINTS=1000

# Opening a market instantly costs this many points (paid into the
# treasury), and its creator then earns MARKET_CREATOR_FEE_BPS of that
# market's rake when it settles (1000 bps = 10% of the terasen).
#
# いまは 0（作成無料）にしています。「作られないより乱立するほうがまし」
# という判断による一時的な設定で、本来はスパム対策の関門です。人が集まったら
# 100 に戻してください。
#
# 副作用: 初期賞金は作成料から出る（MARKET_SEED_BPS）ので、0 にすると
# 初期賞金も 0 になります。stake-back 保証があるので賭けた人が損をすることは
# ありませんが、反対側に誰もいないマーケットは増減なしで終わります。
# また、作成料が0の間はマーケット作成のタブ（有料/無料提案）が消え、
# 即時公開の1本になります。
MARKET_CREATION_COST=0
MARKET_CREATOR_FEE_BPS=1000

# Share of the creation fee that becomes seeded prize money for that
# market's winners (9000 = 90%), with the rest kept by the treasury.
# Without a seed the first bet on an empty market can only break even —
# stake back, no profit — so nobody has a reason to place it.
MARKET_SEED_BPS=9000

# Points locked up when a user proposes a market's result. Returned if the
# result stands, forfeited to the treasury if a DAO vote overturns it —
# this is what stops someone proposing whatever outcome pays their own
# bet. Set it above what a wrong settlement could plausibly earn a liar.
RESOLUTION_BOND=100

# Paid on top of the returned bond when a reported result survives the
# dispute window or the vote. Getting the bond back is not an incentive —
# that is what happens if you do nothing — so this is the actual wage for
# checking a source and reporting it.
#
# 10pt では保証金100ptを預けて報告する割に合わず、報告が集まりませんでした。
# 報告されないマーケットは精算されず、賭けたポイントも戻りません。
#
# 原資: 本来は作成料のうち金庫が残す分でしたが、MARKET_CREATION_COST=0 の
# 間は金庫からの持ち出しになります。作成料を戻すまでは金庫残高を見ながら
# 運用してください。
RESOLUTION_REWARD=100

# How long the community has to dispute a proposed result before it
# settles automatically (1440 = 24h).
DISPUTE_WINDOW_MINUTES=1440

# Disputing costs the same as proposing, so an objection is a claim the
# challenger backs rather than a free way to stall a settlement. The vote
# that follows runs for CHALLENGE_VOTING_HOURS.
CHALLENGE_BOND=100
CHALLENGE_VOTING_HOURS=24

# When the outcome is already known before kickoff, anyone can pay this
# bond to freeze betting immediately and put the result to a short vote.
EARLY_RESOLUTION_BOND=100
EARLY_RESOLUTION_VOTING_HOURS=3

# Share of the loser's forfeited bond handed to whoever turned out to be
# right (7000 = 70%); the treasury keeps the rest.
BOND_AWARD_BPS=7000

# Rewards for voting on a resolution. Correct voters split
# VOTER_RAKE_SHARE_BPS of the market's rake, and the first
# VOTE_REWARD_SLOTS of them also receive VOTE_FLAT_REWARD points each.
# A vote stays listed as a task on /tasks until it has collected
# VOTE_REWARD_SLOTS votes in total.
VOTER_RAKE_SHARE_BPS=5000
VOTE_FLAT_REWARD=30
VOTE_REWARD_SLOTS=10

# Cancelling a bet while the market is still open refunds the stake minus
# this penalty, so cancellation isn't a free option on every odds swing.
BET_CANCEL_PENALTY=3

# Approval votes a *free* proposal needs before it opens for betting.
# (Paying MARKET_CREATION_COST skips this entirely.)
MARKET_APPROVAL_THRESHOLD=3

# Reports needed to remove a market that breaks the guidelines, and what
# each reporter is paid. This is the safety-vs-abuse dial: too high and a
# market that shouldn't exist stays up while people bet on it; too low and
# a few coordinated accounts can destroy legitimate markets. Raise the
# threshold as the user base grows.
#
# 報酬は金庫から支払われます（MARKET_CREATION_COST=0 の間は没収する作成料が
# ないため、全額が金庫の持ち出しです）。
MARKET_BAN_THRESHOLD=3
REPORT_REWARD=30

# Prize money the treasury puts up for a market an admin opens. Admins pay
# no creation fee, so without this the market would open with an empty pot
# and nobody would have a reason to place the first bet. Admin-created
# markets also take no creator fee.
ADMIN_MARKET_SEED=90

# --- マイクロワーク（スポンサー案件）---

# 1ptを何円とみなすか。案件を作るときの既定値で、採算表(campaign_economics)
# の原価計算にそのまま使われる。ポイントは換金できないので実際の債務では
# ないが、この数字を決めないと「1件80円もらって120pt配る」逆ざやの案件が
# 見えないまま増える。
POINT_VALUE_YEN=1.0

# 相互チェックで支払いに必要な賛成数と、チェック1件あたりの報酬の既定値。
# チェック報酬を0にすると誰も見に行かず、提出が保留のまま溜まり続ける
# （管理画面のタスク作成はそもそも0を受け付けない）。
#
# 注意: チェック報酬 x 必要チェック数 が、そのまま1件あたりの原価に上乗せ
# される。報酬30pt・チェック2pt・3人なら原価は36pt。
MICRO_WORK_QUORUM=3
PEER_REVIEW_REWARD=2

# 受注額のうちユーザーへの報酬に回す割合の目安（6000 bps = 60%）。管理画面
# でタスクを作るときに推奨値として表示するだけで、強制はしない。残りが
# サーバー代・審査の手間・金庫への積み立てになる。
WORK_PAYOUT_RATIO_BPS=6000

# --- Sports API sync (scripts/sync-fixtures.mjs, scripts/sync-results.mjs) ---

# Prize money the treasury puts up for each automatically created fixture
# market. Without it the first person to bet can only break even, so an
# auto-filled board sits untouched. Charged once, on first creation — a
# repeat sync never tops up an existing market's pot.
AUTO_MARKET_SEED=90

# "mock" needs no key and generates fake J1-style fixtures, so
# `npm run sync-fixtures` / `npm run sync-results` work out of the box.
#
# "thesportsdb" is the recommended real source: a documented free API that
# actually covers Japanese leagues (J1/J2/J3, NPB, B.League). Set the two
# variables below and switch SPORTS_API_PROVIDER to thesportsdb.
#
# Set to "api_football" to fetch real matches from api-football.com.
# NOTE: if you set API_FOOTBALL_KEY below but leave this on "mock", the
# sync scripts keep generating fake fixtures — they now warn about it.
# Leaving this line commented out auto-selects api_football once a key is
# present.
SPORTS_API_PROVIDER=mock

# --- thesportsdb ---
#
# NOT required. TheSportsDB publishes a shared free key and this uses it
# automatically (currently "123"). Set this only if you have a Premium key
# from your thesportsdb.com user profile.
# SPORTSDB_KEY=

# Which competitions to pull. Look the ids up rather than copying them
# from anywhere — they are not guessable and do get renumbered:
#   npm run sports-leagues -- Japan Soccer
#   npm run sports-leagues -- Japan Baseball
#
# Verified ids at the time of writing: 4633 J1, 4824 J2, 4967 J3,
# 5637 天皇杯, 5826 JFL, 4591 NPB. name is display-only; category must
# be a key from lib/categories.ts (soccer / baseball / sports_other).
# SPORTSDB_LEAGUES=[{"id":"4633","name":"J1リーグ","category":"soccer"},{"id":"5637","name":"天皇杯","category":"soccer"}]

# Required only when SPORTS_API_PROVIDER=api_football. Key from
# https://www.api-football.com/ (or the RapidAPI listing).
# API_FOOTBALL_KEY=

# J1 League's ID in API-Football, and the season to pull.
# IMPORTANT: API-Football's free plan only covers a fixed set of past
# seasons — requesting a season your plan doesn't include returns 0
# results (or an `errors` payload) rather than an HTTP error, which looks
# exactly like "nothing is updating". Check which seasons your plan
# allows at https://v3.football.api-sports.io/leagues?id=98 and set
# API_FOOTBALL_SEASON to one of them.
API_FOOTBALL_LEAGUE_ID=98
API_FOOTBALL_SEASON=2026

# How many days ahead sync-fixtures looks for upcoming matches, and how
# long submit_provisional_result's dispute window lasts once sync-results
# posts a fetched final score.
#
# 7 で約1週間分、14 で2節ぶんくらいがまとめて作られます。
SPORTS_API_SYNC_DAYS=14

# 1回の同期で作るマーケット数の上限。
#
# 取得元がシーズン全体を返すため、期間の絞り込みが効かなくなると1シーズン
# 分（数百試合）が一度に作られ、そのぶん初期賞金が金庫から出ていきます。
# 通常の1〜2週間分がここに引っかかることはありません。上限を超えた分は
# 捨てられるのではなく、次回の同期で取り込まれます。
SPORTS_API_MAX_MARKETS_PER_SYNC=60
SPORTS_API_DISPUTE_WINDOW_MINUTES=1440
